# ==============================================================================
# CineFlow Studio: Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# DO NOT commit .env containing real credentials or private keys to git.

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform & Vertex AI Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=cineflow-10
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Model Roster Defaults
DEFAULT_MODEL=gemini-3.7-flash
SHOWRUNNER_FALLBACK_MODEL=gemini-2.5-pro
QA_MODEL=gemini-3.7-flash

# Optional: Google AI Studio API Key (if not using Vertex AI ADC)
# GEMINI_API_KEY=your-api-key-here

# ------------------------------------------------------------------------------
# 2. CineFlow Studio Services & GCS Storage
# ------------------------------------------------------------------------------
CINEFLOW_STORAGE_BUCKET=gs://cineflow-studio-assets
CINEFLOW_API_URL=http://localhost:8000
CINEFLOW_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Apigee AI Gateway & Model Armor Governance (Optional)
# ------------------------------------------------------------------------------
# APIGEE_PROXY_URL=https://your-apigee-host.example.com/v1/ai-gateway
# APIGEE_API_KEY=your-apigee-api-key
# MODEL_ARMOR_TEMPLATE=projects/cineflow-10/locations/global/templates/film-safety-v1

# ------------------------------------------------------------------------------
# 4. OpenTelemetry & Cloud Observability (Optional)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=cineflow-studio
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-endpoint/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
